# ==============================================================================
# Production Environment Variables (Vercel & Docker)
# ==============================================================================
# Set these in the Vercel Project Settings > Environment Variables,
# or in your production Docker container environment.
# NEVER commit real production secrets to Git!

# --- Server & Environment ---
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Frontend Origin for CORS (e.g. your Vercel domain or custom domain)
# In Vercel unified deployment, frontend and backend share the same domain.
CORS_ORIGIN=https://your-domain.vercel.app

# --- Database ---
# MongoDB Atlas connection string (REQUIRED on Vercel)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# --- Session Management ---
# Long random string for session encryption (REQUIRED in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=
SESSION_COOKIE_NAME=sid
SESSION_MAX_AGE_MS=604800000

# --- Razorpay Payment Gateway ---
# Get live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Bootstrap Admin (Optional) ---
# Used once on startup to create the initial admin account if none exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

