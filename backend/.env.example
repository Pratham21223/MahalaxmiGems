# Server configuration (copy to .env and fill in — never commit .env)
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Database (MongoDB + Mongoose per plan.txt)
MONGODB_URI=mongodb://127.0.0.1:27017/gemstone_store

# Server-side session secret (REQUIRED in production — strong random value)
SESSION_SECRET=replace-with-a-long-random-string
# SESSION_COOKIE_NAME=sid
# SESSION_MAX_AGE_MS=604800000

# Razorpay (test mode during development). Empty values disable live payment,
# but checkout requires a configured Razorpay account to create orders.
RAZORPAY_KEY_ID=rzp_test_TZVXRNhsi3HAyK
RAZORPAY_KEY_SECRET=u3xCz60xCEwxAVkw5q4vJB3G
RAZORPAY_WEBHOOK_SECRET=123456

# Bootstrap admin (used once to create the first admin user on startup)
ADMIN_EMAIL=
ADMIN_PASSWORD=
